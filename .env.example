# Service Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=nestjs-ddd-api
SERVICE_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_project
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_project

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Queued resilience tier (BullMQ) — reuses the Redis server above on a separate logical DB
REDIS_QUEUE_DB=1
QUEUE_CONCURRENCY=4
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000

# Observability
LOG_LEVEL=debug
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9464

# Security
JWT_SECRET=super-secret-key-change-me-in-production
RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-32-chars-min-secret-value
# Origins of frontend clients served from a different origin/port (comma-separated).
# 3001 = Next.js web FE (being retired in favour of app-tu-phuc-vu-mobile). The Expo
# app calls cross-origin from the device — if better-auth rejects RN requests at the
# smoke test, add the offending origin (often the Expo dev bundle URL) here.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Zalo OAuth (social login)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=http://localhost:3000/api/auth/zalo/callback

# Zalo OA — OTP delivery via ZNS message (better-auth phoneNumber plugin sendOTP).
# Fill credentials from a registered Zalo Official Account to deliver the
# registration/login OTP via a Zalo message (Pc, 2026-07-06).
# ZALO_OA_*                = OA credentials for outbound messaging + access-token refresh.
# ZALO_OA_OTP_TEMPLATE_ID  = the OA's approved "OTP" ZNS template id.
# When unset, ZaloOaClient falls back to logging the OTP (dev) — registration still works.
ZALO_OA_ID=
ZALO_OA_APP_ID=
ZALO_OA_APP_SECRET=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_OTP_TEMPLATE_ID=
ZALO_OA_BASE_URL=https://openapi.zaloapp.com

# ── Notification platform (notification-be-rs) — real OTP delivery via gRPC ──────
# The BFF's notification port 'send-otp' live adapter calls notification-be-rs gRPC
# NotificationService/Send (proto: src/libs/shared/proto/notification.proto) with the
# 'customer.otp' template (seeded by notification-be-rs migration 0018).
# CONFIG-GATED: when NOTIFICATION_GRPC_URL is unset (or gRPC fails), send-otp falls
# back silently to {sent:true} so login still works without the platform wired
# (the better-auth setup logs the OTP in dev). Set these to deliver OTP for real:
NOTIFICATION_GRPC_URL=              # e.g. localhost:50051 (notification-be-rs gRPC port). Empty = fallback.
NOTIFICATION_TENANT_ID=tnt_hawaco
# Keycloak Service-Account token (client_credentials) for BFF→platform gRPC auth.
# notification-be-rs validates RS256 + issuer only (no audience/role for Send).
# When KEYCLOAK_SA_* unset → no auth metadata (use with notification-be-rs AUTH_ENABLED=false for local dev).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=water-platform
KEYCLOAK_SA_CLIENT_ID=              # the cloned SA client (e.g. app-tu-phuc-vu) — see docs/notification-real-connect/keycloak-client-app-tu-phuc-vu.json
KEYCLOAK_SA_CLIENT_SECRET=          # the client's secret

# ── CSKH inbound chat (app-tu-phuc-vu → omichannel_be) ─────────────────────────
# Customer chat message forward tới CSKH agent inbox (omichannel_be /webhooks/app).
# Port 'cskh-chat' live adapter POSTs {userId, messageId, text} → /webhooks/app,
# channel normalized = APP, conversation keyed by (APP, userId).
# CONFIG-GATED: empty = mock (log, không forward). Set base URL của omichannel_be:
CSKH_WEBHOOK_URL=                   # e.g. http://localhost:4001 (omichannel_be). Empty = mock.
# HMAC secret ký mọi request tới /webhooks/* (header x-timestamp + x-signature).
# PHẢI trùng giá trị với WEBHOOK_HMAC_SECRET của omichannel_be; thiếu → mọi call
# bị receiver từ chối (401). Spec: docs/cskh-chat-webhook-auth.md
CSKH_WEBHOOK_HMAC_SECRET=           # openssl rand -hex 32
